venv/

# AWS SAM / CDK build artifacts
.aws-sam/
cdk.out/

# Environment and secrets - never commit these
.env
.env.*
*.pem
*.key
credentials.json

# CloudFormation change set / packaged output
packaged-*.yaml
out.yaml

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Local test payloads that may contain real sample data
/test-events/local-only/

body.json
key.json
deployed-*.yaml
*.packaged.yaml

